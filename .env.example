NODE_ENV=development
PORT=4000
DATABASE_URL=mysql://medpm:change-me-local-only@localhost:3306/medpm?charset=utf8mb4

# Optional registration invite; users without one register as PENDING.
# 可选：注册邀请码
# 配置后，携带正确邀请码的注册用户直接 ACTIVE
# 未配置或邀请码错误，注册用户进入 PENDING，等待管理员激活
REGISTRATION_INVITE_CODE=

# Generate a secret with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# SESSION_SECRET=<paste-generated-secret-here>
AI_PROVIDER=openai
AI_MODEL=gpt-4.1-mini
LLM_DEFAULT_MODEL=
# Optional OpenAI-compatible endpoint. AI_MODEL takes precedence over LLM_DEFAULT_MODEL.
# DashScope: OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Set AI_MODEL=qwen-flash and OPENAI_EMBEDDING_MODEL=text-embedding-v4 for DashScope (1536 dimensions).
OPENAI_BASE_URL=
# OpenAI embeddings are used for 1536-dimensional task-history and document vectors for every chat provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
MYSQL_ROOT_PASSWORD=change-me-root-local-only
MYSQL_DATABASE=medpm
MYSQL_USER=medpm
MYSQL_PASSWORD=change-me-local-only
MILVUS_ADDRESS=localhost:19530
MILVUS_TOKEN=
MILVUS_BUCKET=milvus-data
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=medpm
MINIO_SECRET_KEY=change-me-local-only
MINIO_BUCKET=medpm-documents

# MinerU cloud v4. Secrets belong only in local .env / deployment secret storage.
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_API_KEY=
MINERU_MODEL_VERSION=vlm
REDIS_URL=redis://localhost:6379
