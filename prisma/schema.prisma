generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// User reporting records never grant permission to mutate project business assets.
model WeeklyReportPeriod {
  weekStart DateTime @id @db.DateTime(3)
  deadline DateTime @db.DateTime(3)
  createdAt DateTime @default(now()) @db.DateTime(3)
}

model WeeklyReportExpectation {
  id String @id @default(uuid()) @db.Char(36)
  authorId String @db.Char(36)
  weekStart DateTime @db.DateTime(3)
  role Role
  deadline DateTime @db.DateTime(3)
  exemptReason String? @db.VarChar(500)
  createdAt DateTime @default(now()) @db.DateTime(3)
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)
  @@unique([authorId, weekStart])
  @@index([weekStart, deadline])
}

model WeeklyReport {
  id String @id @default(uuid()) @db.Char(36)
  authorId String @db.Char(36)
  weekStart DateTime @db.DateTime(3)
  state String @default("DRAFT") @db.VarChar(20)
  rowVersion Int @default(1)
  submittedAt DateTime? @db.DateTime(3)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)
  sections WeeklyReportSection[]
  revisions WeeklyReportRevision[]
  @@unique([authorId, weekStart])
  @@index([weekStart, state])
}

model WeeklyReportSection {
  id String @id @default(uuid()) @db.Char(36)
  reportId String @db.Char(36)
  projectId String? @db.Char(36)
  projectName String @db.VarChar(191)
  summary String @db.Text
  project Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)
  report WeeklyReport @relation(fields: [reportId], references: [id], onDelete: Restrict)
  items WeeklyReportItem[]
  @@index([reportId])
  @@index([projectId, reportId])
}

model WeeklyReportItem {
  id String @id @default(uuid()) @db.Char(36)
  sectionId String @db.Char(36)
  kind String @db.VarChar(20)
  position Int @default(0)
  text String @db.Text
  sourceType String? @db.VarChar(20)
  sourceId String? @db.Char(36)
  targetDate DateTime? @db.DateTime(3)
  declaredHours Decimal? @db.Decimal(6, 2)
  section WeeklyReportSection @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  @@index([sectionId])
}

model WeeklyReportRevision {
  id String @id @default(uuid()) @db.Char(36)
  reportId String @db.Char(36)
  version Int
  snapshot Json
  sha256 String @db.Char(64)
  submittedAt DateTime @default(now()) @db.DateTime(3)
  report WeeklyReport @relation(fields: [reportId], references: [id], onDelete: Restrict)
  reviews WeeklyReportReview[]
  @@unique([reportId, version])
}

model WeeklyReportReview {
  id String @id @default(uuid()) @db.Char(36)
  revisionId String @db.Char(36)
  sectionId String @db.Char(36)
  sectionSha256 String @db.Char(64)
  actorId String @db.Char(36)
  decision String @db.VarChar(20)
  reason String @db.VarChar(1000)
  createdAt DateTime @default(now()) @db.DateTime(3)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  revision WeeklyReportRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  @@unique([revisionId, sectionId, actorId])
  @@index([sectionId, sectionSha256])
}

enum Role {
  ADMIN
  PM
  MEMBER
  QA
  PMO
}

enum UserStatus {
  ACTIVE
  DISABLED
  PENDING
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  PENDING_ACCEPTANCE
  ARCHIVED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum RequirementStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  RETIRED
}

enum TestCaseStatus {
  NOT_RUN
  PASSED
  FAILED
  BLOCKED
}

enum AIRecommendationStatus {
  PENDING_CONFIRMATION
  ACCEPTED
  REJECTED
}

enum AiSuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum AiSuggestionType {
  WBS
  ESTIMATE
  RISK
  AUDIT_SUMMARY
  MEETING_SUMMARY
  ACCEPTANCE_DIAGNOSIS
}

enum MeetingStatus {
  DRAFT
  FINALIZED
}

model User {
  assignedAuditIssues AuditIssue[] @relation("AuditIssueAssignee")
  auditIssueEvents AuditIssueEvent[]
  weeklyReports WeeklyReport[]
  weeklyExpectations WeeklyReportExpectation[]
  weeklyReviews WeeklyReportReview[]
  id                      String                    @id @default(uuid()) @db.Char(36)
  email                   String                    @unique @db.VarChar(191)
  name                    String                    @db.VarChar(191)
  role                    Role                      @default(MEMBER)
  passwordHash            String?                   @db.VarChar(255)
  isSystem                Boolean                   @default(false)
  status                  UserStatus                @default(PENDING)
  lastLoginAt             DateTime?                 @db.DateTime(3)
  failedLoginCount        Int                       @default(0)
  lockedUntil             DateTime?                 @db.DateTime(3)
  createdAt               DateTime                  @default(now()) @db.DateTime(3)
  updatedAt               DateTime                  @updatedAt @db.DateTime(3)
  complianceChecks ProjectComplianceCheck[]
  cancelledTasks Task[] @relation("TaskCanceller")
  projectStatusChanges    ProjectStatusChange[]
  ownedProjects           Project[]                 @relation("ProjectOwner")
  uploadedDocuments       Document[]                @relation("DocumentUploader")
  createdDeliverables     Deliverable[]             @relation("DeliverableCreator")
  reviewedDeliverables    Deliverable[]             @relation("DeliverableReviewer")
  submittedDeliverables   Deliverable[]             @relation("DeliverableSubmitter")
  meetingRecords          MeetingRecord[]
  documentParseJobs       DocumentParseJob[]        @relation("DocumentParseRequester")
  tasks                   Task[]
  weeklyCapacities         MemberWeeklyCapacity[]
  riskSchedules           RiskScanSchedule[]
  riskNotifications       RiskNotification[]
  projectMemberships      ProjectMember[]
  complianceExports       ComplianceExport[]
  reviewedRecommendations AIRecommendation[]        @relation("RecommendationReviewer")
  reviewedSuggestions     AiSuggestion[]            @relation("SuggestionReviewer")
  auditLogs               AuditLog[]
  sessions                Session[]
  ragConversations        RagConversation[]
  passwordResetTokens     PasswordResetToken[]
  requirementTaskReviews  Task[]                    @relation("TaskRequirementReviewer")
  requirementTestReviews  TestCase[]                @relation("TestRequirementReviewer")
  complianceReviews       ComplianceFindingReview[]
  submittedAcceptances    ProjectAcceptance[] @relation("AcceptanceSubmitter")
  qaAcceptances           ProjectAcceptance[] @relation("AcceptanceQA")
  archivedProjects        Project[] @relation("ProjectArchiver")
  projectNotifications    ProjectNotification[]

  @@index([isSystem])
}

model RagConversation {
  id String @id @default(uuid()) @db.Char(36)
  userId String @db.Char(36)
  title String @db.VarChar(191)
  projectId String? @db.Char(36)
  rowVersion Int @default(1) @db.UnsignedInt
  activeRequestId String? @db.Char(36)
  leaseUntil DateTime? @db.DateTime(3)
  hiddenAt DateTime? @db.DateTime(3)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  messages RagMessage[]
  @@index([userId, hiddenAt, updatedAt])
}

model RagMessage {
  id String @id @default(uuid()) @db.Char(36)
  conversationId String @db.Char(36)
  requestKey String @db.Char(36)
  sequence Int @db.UnsignedInt
  role String @db.VarChar(16)
  actorRole Role
  content String @db.Text
  status String @db.VarChar(16)
  scopeProjectIds Json
  model String? @db.VarChar(191)
  retrievalMode String? @db.VarChar(32)
  mode String @default("INTERNAL") @db.VarChar(16)
  intent String? @db.VarChar(32)
  webQuery String? @db.VarChar(2000)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  conversation RagConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  citations RagCitation[]
  @@unique([conversationId, requestKey, role])
  @@unique([conversationId, sequence])
  @@index([conversationId, createdAt])
}

model RagCitation {
  id String @id @default(uuid()) @db.Char(36)
  messageId String @db.Char(36)
  ordinal Int @db.UnsignedInt
  sourceType String @db.VarChar(16)
  projectId String? @db.Char(36)
  documentId String? @db.Char(36)
  chunkId String? @db.Char(36)
  contactId String? @db.Char(36)
  version Int? @db.UnsignedInt
  page Int? @db.UnsignedInt
  title String @db.VarChar(255)
  snippet String @db.Text
  contentSha256 String @db.Char(64)
  webUrl String? @db.VarChar(2048)
  retrievedAt DateTime? @db.DateTime(3)
  publishedAt DateTime? @db.DateTime(3)
  message RagMessage @relation(fields: [messageId], references: [id], onDelete: Restrict)
  @@unique([messageId, ordinal])
  @@index([projectId, documentId])
}

model Session {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @db.Char(36)
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime  @db.DateTime(3)
  createdAt DateTime  @default(now()) @db.DateTime(3)
  revokedAt DateTime? @db.DateTime(3)
  ip        String?   @db.VarChar(45)
  userAgent String?   @db.VarChar(512)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @db.Char(36)
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime  @db.DateTime(3)
  usedAt    DateTime? @db.DateTime(3)
  createdAt DateTime  @default(now()) @db.DateTime(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Project {
  auditIssues AuditIssue[]
  decisionSnapshots DecisionSnapshot[]
  weeklyReportSections WeeklyReportSection[]
  id              String             @id @default(uuid()) @db.Char(36)
  name            String             @db.VarChar(191)
  description     String?            @db.Text
  status          ProjectStatus      @default(PLANNING)
  rowVersion      Int                @default(1) @db.UnsignedInt
  pausedFromStatus String? @db.VarChar(32)
  currentStatusChangeId String? @unique @db.Char(36)
  currentStatusChange ProjectStatusChange? @relation("CurrentProjectStatusChange", fields: [currentStatusChangeId], references: [id], onDelete: Restrict)
  statusChanges ProjectStatusChange[] @relation("ProjectStatusChanges")
  currentAcceptanceId String?        @unique @db.Char(36)
  currentAcceptance ProjectAcceptance? @relation("CurrentAcceptance", fields: [currentAcceptanceId], references: [id], onDelete: Restrict)
  acceptances     ProjectAcceptance[] @relation("ProjectAcceptances")
  archivedAt      DateTime?          @db.DateTime(3)
  archivedById    String?            @db.Char(36)
  archivedBy      User?              @relation("ProjectArchiver", fields: [archivedById], references: [id], onDelete: Restrict)
  notifications   ProjectNotification[]
  ownerId         String?            @db.Char(36)
  createdAt       DateTime           @default(now()) @db.DateTime(3)
  updatedAt       DateTime           @updatedAt @db.DateTime(3)
  owner           User?              @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tasks           Task[]
  requirements    Requirement[]
  requirementIntakes RequirementIntake[]
  requirementRevisions RequirementRevision[]
  requirementChanges RequirementChangeRequest[]
  requirementLinks RequirementTaskLink[]
  requirementDecisions RequirementDecision[]
  testExecutions TestExecution[]
  requirementBaselines RequirementBaseline[]
  requirementAttachments RequirementAttachment[]
  documents       Document[]
  deliverables    Deliverable[]
  meetingRecords  MeetingRecord[]
  recommendations AIRecommendation[]
  suggestions     AiSuggestion[]
  syncFailures    SyncFailure[]
  auditLogs       AuditLog[]
  riskSchedule    RiskScanSchedule?
  riskScanJobs    RiskScanJob[]
  members         ProjectMember[]
  complianceChecks ProjectComplianceCheck[]
  complianceExports ComplianceExport[]

  @@index([ownerId, status])
  @@index([status, archivedAt])
}

model ProjectStatusChange {
  id String @id @default(uuid()) @db.Char(36)
  projectId String @db.Char(36)
  action String @db.VarChar(32)
  fromStatus String @db.VarChar(32)
  toStatus String @db.VarChar(32)
  reason String @db.VarChar(1000)
  actorId String @db.Char(36)
  requestKey String @db.Char(36)
  expectedRowVersion Int @db.UnsignedInt
  createdAt DateTime @default(now()) @db.DateTime(3)
  project Project @relation("ProjectStatusChanges", fields: [projectId], references: [id], onDelete: Restrict)
  currentFor Project? @relation("CurrentProjectStatusChange")
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@unique([projectId, requestKey])
  @@index([projectId, createdAt])
}

model ProjectAcceptance {
  id             String @id @default(uuid()) @db.Char(36)
  projectId      String @db.Char(36)
  round          Int @db.UnsignedInt
  requestKey     String @db.Char(36)
  state          String @default("SUBMITTED") @db.VarChar(24)
  submittedById  String @db.Char(36)
  submittedAt    DateTime @default(now()) @db.DateTime(3)
  snapshot       Json
  snapshotSha256 String @db.Char(64)
  overrideReason String? @db.Text
  overrideGapCount Int @default(0) @db.UnsignedInt
  overrideCheckId String? @db.Char(36)
  qaApprovedById String? @db.Char(36)
  qaApprovedAt   DateTime? @db.DateTime(3)
  reviewComment  String? @db.Text
  closedAt       DateTime? @db.DateTime(3)
  project        Project @relation("ProjectAcceptances", fields: [projectId], references: [id], onDelete: Restrict)
  currentFor     Project? @relation("CurrentAcceptance")
  submittedBy    User @relation("AcceptanceSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  qaApprovedBy   User? @relation("AcceptanceQA", fields: [qaApprovedById], references: [id], onDelete: Restrict)
  notifications  ProjectNotification[]
  @@unique([projectId, round])
  @@unique([projectId, requestKey])
}

model ProjectNotification {
  id           String @id @default(uuid()) @db.Char(36)
  projectId    String @db.Char(36)
  acceptanceId String @db.Char(36)
  recipientId  String @db.Char(36)
  type         String @default("PROJECT_ARCHIVED") @db.VarChar(32)
  readAt       DateTime? @db.DateTime(3)
  createdAt    DateTime @default(now()) @db.DateTime(3)
  project      Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  acceptance   ProjectAcceptance @relation(fields: [acceptanceId], references: [id], onDelete: Restrict)
  recipient    User @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  @@unique([recipientId, acceptanceId])
  @@index([recipientId, readAt, createdAt])
}

model ProjectMember {
  id        String   @id @default(uuid()) @db.Char(36)
  projectId String   @db.Char(36)
  userId    String   @db.Char(36)
  canOverrideAcceptance Boolean @default(false)
  active    Boolean  @default(true)
  version   Int      @default(1) @db.UnsignedInt
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([projectId, userId])
  @@index([userId, active, projectId])
}

enum ComplianceExportStatus {
  GENERATING
  AVAILABLE
  FAILED
}

model ComplianceExport {
  id          String                 @id @default(uuid()) @db.Char(36)
  projectId   String                 @db.Char(36)
  actorId     String                 @db.Char(36)
  requestKey  String                 @db.Char(36)
  format      String                 @db.VarChar(16)
  status      ComplianceExportStatus @default(GENERATING)
  scope       Json
  minioKey    String                 @db.VarChar(512)
  sha256      String                 @db.Char(64)
  fileSize    Int                    @db.UnsignedInt
  errorCode   String?                @db.VarChar(100)
  createdAt   DateTime               @default(now()) @db.DateTime(3)
  updatedAt   DateTime               @updatedAt @db.DateTime(3)
  project     Project                @relation(fields: [projectId], references: [id], onDelete: Restrict)
  actor       User                   @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@unique([projectId, requestKey])
  @@index([projectId, createdAt])
}

model Task {
  id                         String           @id @default(uuid()) @db.Char(36)
  projectId                  String           @db.Char(36)
  assigneeId                 String?          @db.Char(36)
  title                      String           @db.VarChar(191)
  description                String?          @db.Text
  status                     TaskStatus       @default(TODO)
  requiresDeliverable        Boolean          @default(false)
  deliverables               Deliverable[]
  estimateHours              Decimal?         @db.Decimal(8, 2)
  actualHours                Decimal?         @db.Decimal(8, 2)
  completedAt                DateTime?        @db.DateTime(3)
  rowVersion                 Int @default(1) @db.UnsignedInt
  signatureEvidenceVersion   Int @default(1) @db.UnsignedTinyInt
  cancelReason               String? @db.VarChar(1000)
  cancelledAt                DateTime? @db.DateTime(3)
  cancelledById              String? @db.Char(36)
  cancelledBy User? @relation("TaskCanceller", fields: [cancelledById], references: [id], onDelete: Restrict)
  completionRoundId          String?          @db.Char(36)
  planningStatus             String           @default(dbgenerated()) @db.VarChar(16)
  dueDate                    DateTime?        @db.DateTime(3)
  plannedStartDate           DateTime?        @db.DateTime(3)
  scheduleVersion            Int              @default(0) @db.UnsignedInt
  createdAt                  DateTime         @default(now()) @db.DateTime(3)
  updatedAt                  DateTime         @updatedAt @db.DateTime(3)
  project                    Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  assignee                   User?            @relation(fields: [assigneeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  requirementId              String?          @db.Char(36)
  requirement                Requirement?     @relation(fields: [requirementId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reviewedRequirementVersion Int?             @db.UnsignedInt
  requirementReviewedById    String?          @db.Char(36)
  requirementReviewedAt      DateTime?        @db.DateTime(3)
  requirementReviewer        User?            @relation("TaskRequirementReviewer", fields: [requirementReviewedById], references: [id], onDelete: Restrict)
  dependencies               TaskDependency[] @relation("TaskDependencies")
  requirementLinks RequirementTaskLink[]
  blockedBy                  TaskDependency[] @relation("TaskPrerequisites")

  @@index([projectId, status])
  @@index([assigneeId, status])
  @@index([dueDate, status])
  @@index([requirementId, status])
}

model MemberWeeklyCapacity {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @db.Char(36)
  weekStart DateTime @db.DateTime(3)
  hours     Decimal? @db.Decimal(6, 2)
  version   Int      @default(1) @db.UnsignedInt
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, weekStart])
  @@index([weekStart])
}

model TaskDependency {
  id              String   @id @default(uuid()) @db.Char(36)
  taskId          String   @db.Char(36)
  dependsOnTaskId String   @db.Char(36)
  createdAt       DateTime @default(now()) @db.DateTime(3)
  task            Task     @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  dependsOn       Task     @relation("TaskPrerequisites", fields: [dependsOnTaskId], references: [id], onDelete: Restrict)

  @@unique([taskId, dependsOnTaskId])
  @@index([dependsOnTaskId])
}

model Requirement {
  id        String            @id @default(uuid()) @db.Char(36)
  projectId String            @db.Char(36)
  title     String            @db.VarChar(191)
  content   String            @db.Text
  version   Int               @default(1) @db.UnsignedInt
  status    RequirementStatus @default(DRAFT)
  createdAt DateTime          @default(now()) @db.DateTime(3)
  updatedAt DateTime          @updatedAt @db.DateTime(3)
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  tasks     Task[]
  testCases TestCase[]
  number String? @db.VarChar(32)
  managed Boolean @default(false)
  workflowState String @default("DRAFT") @db.VarChar(32)
  rowVersion Int @default(1) @db.UnsignedInt
  draftVersion Int? @db.UnsignedInt
  approvedVersion Int? @db.UnsignedInt
  createdById String? @db.Char(36)
  ownerId String? @db.Char(36)
  dueDate DateTime? @db.DateTime(3)
  completedAt DateTime? @db.DateTime(3)
  priority String @default("SHOULD") @db.VarChar(16)
  category String @default("FUNCTIONAL") @db.VarChar(24)
  riskLevel String @default("NORMAL") @db.VarChar(16)
  discoveryPhase String? @db.VarChar(50)
  targetRelease String? @db.VarChar(100)
  revisions RequirementRevision[]
  taskLinks RequirementTaskLink[]
  intakes RequirementIntake[]
  changes RequirementChangeRequest[]
  executions TestExecution[]
  decisions RequirementDecision[]
  attachments RequirementAttachment[]

  @@unique([projectId, title, version])
  @@unique([projectId, number])
  @@index([projectId, workflowState, dueDate])
  @@index([projectId, status])
}

// Project-scoped records use the existing project freeze procedure. Approved
// content, executions and decisions are immutable evidence, never overwritten.
model RequirementIntake {
  id String @id @default(uuid()) @db.Char(36)
  projectId String @db.Char(36)
  title String @db.VarChar(191)
  content String @db.Text
  source String @db.VarChar(24)
  sourceReference String? @db.VarChar(191)
  requester String @db.VarChar(191)
  state String @default("SUBMITTED") @db.VarChar(24)
  reason String? @db.Text
  requirementId String? @db.Char(36)
  createdById String @db.Char(36)
  rowVersion Int @default(1) @db.UnsignedInt
  requestKey String @db.Char(36)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  requirement Requirement? @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  attachments RequirementAttachment[]
  @@unique([projectId, requestKey])
  @@index([projectId, state, createdAt])
}

model RequirementRevision {
  id String @id @default(uuid()) @db.Char(36)
  projectId String @db.Char(36)
  requirementId String @db.Char(36)
  version Int @db.UnsignedInt
  title String @db.VarChar(191)
  content String @db.Text
  acceptanceCriteria String @db.Text
  dueDate DateTime @db.DateTime(3)
  metadata Json
  sha256 String @db.Char(64)
  createdById String @db.Char(36)
  createdAt DateTime @default(now()) @db.DateTime(3)
  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  attachments RequirementAttachment[]
  executions TestExecution[]
  @@unique([requirementId, version])
  @@index([projectId, createdAt])
}

model RequirementChangeRequest {
  id String @id @default(uuid()) @db.Char(36)
  projectId String @db.Char(36)
  requirementId String @db.Char(36)
  fromVersion Int @db.UnsignedInt
  previousState String @db.VarChar(32)
  reason String @db.Text
  impact Json
  state String @default("DRAFT") @db.VarChar(24)
  createdById String @db.Char(36)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  @@index([projectId, requirementId, state])
}

model RequirementTaskLink {
  id String @id @default(uuid()) @db.Char(36)
  projectId String @db.Char(36)
  requirementId String @db.Char(36)
  taskId String @db.Char(36)
  createdById String @db.Char(36)
  createdAt DateTime @default(now()) @db.DateTime(3)
  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  task Task @relation(fields: [taskId], references: [id], onDelete: Restrict)
  @@unique([requirementId, taskId])
  @@index([projectId, taskId])
}

model RequirementDecision {
