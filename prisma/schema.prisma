generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PM
  MEMBER
  QA
}

enum UserStatus {
  ACTIVE
  DISABLED
  PENDING
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  PENDING_ACCEPTANCE
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum RequirementStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  RETIRED
}

enum TestCaseStatus {
  NOT_RUN
  PASSED
  FAILED
  BLOCKED
}

enum AIRecommendationStatus {
  PENDING_CONFIRMATION
  ACCEPTED
  REJECTED
}

enum AiSuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum AiSuggestionType {
  WBS
  ESTIMATE
  RISK
  AUDIT_SUMMARY
}

model User {
  id                      String                    @id @default(uuid()) @db.Char(36)
  email                   String                    @unique @db.VarChar(191)
  name                    String                    @db.VarChar(191)
  role                    Role                      @default(MEMBER)
  passwordHash            String?                   @db.VarChar(255)
  isSystem                Boolean                   @default(false)
  status                  UserStatus                @default(PENDING)
  lastLoginAt             DateTime?                 @db.DateTime(3)
  failedLoginCount        Int                       @default(0)
  lockedUntil             DateTime?                 @db.DateTime(3)
  createdAt               DateTime                  @default(now()) @db.DateTime(3)
  updatedAt               DateTime                  @updatedAt @db.DateTime(3)
  ownedProjects           Project[]                 @relation("ProjectOwner")
  uploadedDocuments       Document[]                @relation("DocumentUploader")
  createdDeliverables     Deliverable[]             @relation("DeliverableCreator")
  reviewedDeliverables    Deliverable[]             @relation("DeliverableReviewer")
  submittedDeliverables   Deliverable[]             @relation("DeliverableSubmitter")
  meetingRecords          MeetingRecord[]
  documentParseJobs       DocumentParseJob[]        @relation("DocumentParseRequester")
  tasks                   Task[]
  weeklyCapacities         MemberWeeklyCapacity[]
  riskSchedules           RiskScanSchedule[]
  riskNotifications       RiskNotification[]
  projectMemberships      ProjectMember[]
  complianceExports       ComplianceExport[]
  reviewedRecommendations AIRecommendation[]        @relation("RecommendationReviewer")
  reviewedSuggestions     AiSuggestion[]            @relation("SuggestionReviewer")
  auditLogs               AuditLog[]
  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  requirementTaskReviews  Task[]                    @relation("TaskRequirementReviewer")
  requirementTestReviews  TestCase[]                @relation("TestRequirementReviewer")
  complianceReviews       ComplianceFindingReview[]
  submittedAcceptances    ProjectAcceptance[] @relation("AcceptanceSubmitter")
  qaAcceptances           ProjectAcceptance[] @relation("AcceptanceQA")
  archivedProjects        Project[] @relation("ProjectArchiver")
  projectNotifications    ProjectNotification[]

  @@index([isSystem])
}

model Session {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @db.Char(36)
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime  @db.DateTime(3)
  createdAt DateTime  @default(now()) @db.DateTime(3)
  revokedAt DateTime? @db.DateTime(3)
  ip        String?   @db.VarChar(45)
  userAgent String?   @db.VarChar(512)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @db.Char(36)
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime  @db.DateTime(3)
  usedAt    DateTime? @db.DateTime(3)
  createdAt DateTime  @default(now()) @db.DateTime(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Project {
  id              String             @id @default(uuid()) @db.Char(36)
  name            String             @db.VarChar(191)
  description     String?            @db.Text
  status          ProjectStatus      @default(PLANNING)
  rowVersion      Int                @default(1) @db.UnsignedInt
  currentAcceptanceId String?        @unique @db.Char(36)
  currentAcceptance ProjectAcceptance? @relation("CurrentAcceptance", fields: [currentAcceptanceId], references: [id], onDelete: Restrict)
  acceptances     ProjectAcceptance[] @relation("ProjectAcceptances")
  archivedAt      DateTime?          @db.DateTime(3)
  archivedById    String?            @db.Char(36)
  archivedBy      User?              @relation("ProjectArchiver", fields: [archivedById], references: [id], onDelete: Restrict)
  notifications   ProjectNotification[]
  ownerId         String?            @db.Char(36)
  createdAt       DateTime           @default(now()) @db.DateTime(3)
  updatedAt       DateTime           @updatedAt @db.DateTime(3)
  owner           User?              @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tasks           Task[]
  requirements    Requirement[]
  documents       Document[]
  deliverables    Deliverable[]
  meetingRecords  MeetingRecord[]
  recommendations AIRecommendation[]
  suggestions     AiSuggestion[]
  syncFailures    SyncFailure[]
  auditLogs       AuditLog[]
  riskSchedule    RiskScanSchedule?
  riskScanJobs    RiskScanJob[]
  members         ProjectMember[]
  complianceExports ComplianceExport[]

  @@index([ownerId, status])
}

model ProjectAcceptance {
  id             String @id @default(uuid()) @db.Char(36)
  projectId      String @db.Char(36)
  round          Int @db.UnsignedInt
  requestKey     String @db.Char(36)
  state          String @default("SUBMITTED") @db.VarChar(24)
  submittedById  String @db.Char(36)
  submittedAt    DateTime @default(now()) @db.DateTime(3)
  snapshot       Json
  snapshotSha256 String @db.Char(64)
  qaApprovedById String? @db.Char(36)
  qaApprovedAt   DateTime? @db.DateTime(3)
  reviewComment  String? @db.Text
  closedAt       DateTime? @db.DateTime(3)
  project        Project @relation("ProjectAcceptances", fields: [projectId], references: [id], onDelete: Restrict)
  currentFor     Project? @relation("CurrentAcceptance")
  submittedBy    User @relation("AcceptanceSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  qaApprovedBy   User? @relation("AcceptanceQA", fields: [qaApprovedById], references: [id], onDelete: Restrict)
  notifications  ProjectNotification[]
  @@unique([projectId, round])
  @@unique([projectId, requestKey])
}

model ProjectNotification {
  id           String @id @default(uuid()) @db.Char(36)
  projectId    String @db.Char(36)
  acceptanceId String @db.Char(36)
  recipientId  String @db.Char(36)
  type         String @default("PROJECT_ARCHIVED") @db.VarChar(32)
  readAt       DateTime? @db.DateTime(3)
  createdAt    DateTime @default(now()) @db.DateTime(3)
  project      Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  acceptance   ProjectAcceptance @relation(fields: [acceptanceId], references: [id], onDelete: Restrict)
  recipient    User @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  @@unique([recipientId, acceptanceId])
  @@index([recipientId, readAt, createdAt])
}

model ProjectMember {
  id        String   @id @default(uuid()) @db.Char(36)
  projectId String   @db.Char(36)
  userId    String   @db.Char(36)
  active    Boolean  @default(true)
  version   Int      @default(1) @db.UnsignedInt
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([projectId, userId])
  @@index([userId, active, projectId])
}

enum ComplianceExportStatus {
  GENERATING
  AVAILABLE
  FAILED
}

model ComplianceExport {
  id          String                 @id @default(uuid()) @db.Char(36)
  projectId   String                 @db.Char(36)
  actorId     String                 @db.Char(36)
  requestKey  String                 @db.Char(36)
  format      String                 @db.VarChar(16)
  status      ComplianceExportStatus @default(GENERATING)
  scope       Json
  minioKey    String                 @db.VarChar(512)
  sha256      String                 @db.Char(64)
  fileSize    Int                    @db.UnsignedInt
  errorCode   String?                @db.VarChar(100)
  createdAt   DateTime               @default(now()) @db.DateTime(3)
  updatedAt   DateTime               @updatedAt @db.DateTime(3)
  project     Project                @relation(fields: [projectId], references: [id], onDelete: Restrict)
  actor       User                   @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@unique([projectId, requestKey])
  @@index([projectId, createdAt])
}

model Task {
  id                         String           @id @default(uuid()) @db.Char(36)
  projectId                  String           @db.Char(36)
  assigneeId                 String?          @db.Char(36)
  title                      String           @db.VarChar(191)
  description                String?          @db.Text
  status                     TaskStatus       @default(TODO)
  requiresDeliverable        Boolean          @default(false)
  deliverables               Deliverable[]
  estimateHours              Decimal?         @db.Decimal(8, 2)
  actualHours                Decimal?         @db.Decimal(8, 2)
  completedAt                DateTime?        @db.DateTime(3)
  dueDate                    DateTime?        @db.DateTime(3)
  plannedStartDate           DateTime?        @db.DateTime(3)
  scheduleVersion            Int              @default(0) @db.UnsignedInt
  createdAt                  DateTime         @default(now()) @db.DateTime(3)
  updatedAt                  DateTime         @updatedAt @db.DateTime(3)
  project                    Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  assignee                   User?            @relation(fields: [assigneeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  requirementId              String?          @db.Char(36)
  requirement                Requirement?     @relation(fields: [requirementId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reviewedRequirementVersion Int?             @db.UnsignedInt
  requirementReviewedById    String?          @db.Char(36)
  requirementReviewedAt      DateTime?        @db.DateTime(3)
  requirementReviewer        User?            @relation("TaskRequirementReviewer", fields: [requirementReviewedById], references: [id], onDelete: Restrict)
  dependencies               TaskDependency[] @relation("TaskDependencies")
  blockedBy                  TaskDependency[] @relation("TaskPrerequisites")

  @@index([projectId, status])
  @@index([assigneeId, status])
  @@index([dueDate, status])
  @@index([requirementId, status])
}

model MemberWeeklyCapacity {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @db.Char(36)
  weekStart DateTime @db.DateTime(3)
  hours     Decimal? @db.Decimal(6, 2)
  version   Int      @default(1) @db.UnsignedInt
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, weekStart])
  @@index([weekStart])
}

model TaskDependency {
  id              String   @id @default(uuid()) @db.Char(36)
  taskId          String   @db.Char(36)
  dependsOnTaskId String   @db.Char(36)
  createdAt       DateTime @default(now()) @db.DateTime(3)
  task            Task     @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  dependsOn       Task     @relation("TaskPrerequisites", fields: [dependsOnTaskId], references: [id], onDelete: Restrict)

  @@unique([taskId, dependsOnTaskId])
  @@index([dependsOnTaskId])
}

model Requirement {
  id        String            @id @default(uuid()) @db.Char(36)
  projectId String            @db.Char(36)
  title     String            @db.VarChar(191)
  content   String            @db.Text
  version   Int               @default(1) @db.UnsignedInt
  status    RequirementStatus @default(DRAFT)
  createdAt DateTime          @default(now()) @db.DateTime(3)
  updatedAt DateTime          @updatedAt @db.DateTime(3)
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  tasks     Task[]
  testCases TestCase[]

  @@unique([projectId, title, version])
  @@index([projectId, status])
}

model TestCase {
  id                         String         @id @default(uuid()) @db.Char(36)
  requirementId              String         @db.Char(36)
  title                      String         @db.VarChar(191)
  status                     TestCaseStatus @default(NOT_RUN)
  createdAt                  DateTime       @default(now()) @db.DateTime(3)
  updatedAt                  DateTime       @updatedAt @db.DateTime(3)
  requirement                Requirement    @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  reviewedRequirementVersion Int?           @db.UnsignedInt
  requirementReviewedById    String?        @db.Char(36)
  requirementReviewedAt      DateTime?      @db.DateTime(3)
  requirementReviewer        User?          @relation("TestRequirementReviewer", fields: [requirementReviewedById], references: [id], onDelete: Restrict)

  @@index([requirementId, status])
}

// Retained for compatibility with records written by the first project scaffold.
model AIRecommendation {
  id           String                 @id @default(uuid()) @db.Char(36)
  projectId    String                 @db.Char(36)
  reviewedById String?                @db.Char(36)
  kind         String                 @db.VarChar(40)
  payload      Json
  status       AIRecommendationStatus @default(PENDING_CONFIRMATION)
  createdAt    DateTime               @default(now()) @db.DateTime(3)
  reviewedAt   DateTime?              @db.DateTime(3)
  project      Project                @relation(fields: [projectId], references: [id], onDelete: Restrict)
  reviewedBy   User?                  @relation("RecommendationReviewer", fields: [reviewedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([projectId, status, createdAt])
}

model AiSuggestion {
  id             String                    @id @default(uuid()) @db.Char(36)
  projectId      String                    @db.Char(36)
  type           AiSuggestionType
  input          Json
  output         Json
  status         AiSuggestionStatus        @default(PENDING)
  reviewedById   String?                   @db.Char(36)
  reviewedAt     DateTime?                 @db.DateTime(3)
  createdAt      DateTime                  @default(now()) @db.DateTime(3)
  project        Project                   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  reviewedBy     User?                     @relation("SuggestionReviewer", fields: [reviewedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  findingReviews ComplianceFindingReview[]
  riskNotifications RiskNotification[]

  @@index([projectId, status, createdAt])
}

model RiskScanSchedule {
  id             String   @id @default(uuid()) @db.Char(36)
  projectId      String   @unique @db.Char(36)
  configuredById String   @db.Char(36)
  enabled        Boolean  @default(false)
  intervalMinutes Int     @default(60) @db.UnsignedInt
  version        Int      @default(1) @db.UnsignedInt
  nextRunAt      DateTime @db.DateTime(3)
  createdAt      DateTime @default(now()) @db.DateTime(3)
  updatedAt      DateTime @updatedAt @db.DateTime(3)
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  configuredBy   User     @relation(fields: [configuredById], references: [id], onDelete: Restrict)
  jobs           RiskScanJob[]
  @@index([enabled, nextRunAt])
}

enum RiskScanJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

model RiskScanJob {
  id              String            @id @default(uuid()) @db.Char(36)
  scheduleId      String            @db.Char(36)
  scheduleVersion Int               @db.UnsignedInt
  projectId       String            @db.Char(36)
  dueAt           DateTime          @db.DateTime(3)
  nextRunAt       DateTime          @db.DateTime(3)
  status          RiskScanJobStatus @default(QUEUED)
  attempts        Int               @default(0) @db.UnsignedInt
  leaseToken      String?           @db.Char(36)
  leaseUntil      DateTime?         @db.DateTime(3)
  errorCode       String?           @db.VarChar(100)
  batchId         String?           @db.Char(36)
  suggestionCount Int?              @db.UnsignedInt
  completedAt     DateTime?         @db.DateTime(3)
  createdAt       DateTime          @default(now()) @db.DateTime(3)
  updatedAt       DateTime          @updatedAt @db.DateTime(3)
  schedule        RiskScanSchedule  @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  project         Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  @@unique([scheduleId, dueAt])
  @@index([status, nextRunAt, leaseUntil])
  @@index([projectId, createdAt])
}

model RiskNotification {
  id           String       @id @default(uuid()) @db.Char(36)
  userId       String       @db.Char(36)
  suggestionId String       @db.Char(36)
  readAt       DateTime?    @db.DateTime(3)
  createdAt    DateTime     @default(now()) @db.DateTime(3)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  suggestion   AiSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Restrict)
  @@unique([userId, suggestionId])
  @@index([userId, readAt, createdAt])
  @@index([suggestionId])
}

model ComplianceFindingReview {
  id           String                    @id @default(uuid()) @db.Char(36)
  suggestionId String                    @db.Char(36)
  findingKey   String                    @db.VarChar(191)
  decision     ComplianceFindingDecision
  note         String                    @db.VarChar(2000)
  reviewedById String                    @db.Char(36)
  createdAt    DateTime                  @default(now()) @db.DateTime(3)
  suggestion   AiSuggestion              @relation(fields: [suggestionId], references: [id], onDelete: Restrict)
  reviewer     User                      @relation(fields: [reviewedById], references: [id], onDelete: Restrict)

  @@unique([suggestionId, findingKey])
  @@index([reviewedById, createdAt])
}

enum ComplianceFindingDecision {
  CONFIRMED
  DISMISSED
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Char(36)
  actorId    String   @db.Char(36)
  projectId  String?  @db.Char(36)
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(100)
  entityId   String   @db.Char(36)
  before     Json?
  after      Json?
  ip         String?  @db.VarChar(45)
  userAgent  String?  @db.VarChar(512)
  createdAt  DateTime @default(now()) @db.DateTime(3)
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([projectId, createdAt])
  @@index([action, createdAt])
}

model Document {
  id            String                @id @default(uuid()) @db.Char(36)
  projectId     String                @db.Char(36)
  filename      String                @db.VarChar(512)
  deliverable   Deliverable?
  meetingRecord MeetingRecord?
  assetJob      AssetSourceJob?
  documentType  String                @default("DOCUMENT") @db.VarChar(32)
  visibleRoles  Json                  @default("[\"ADMIN\",\"PM\",\"QA\",\"MEMBER\"]")
  minioKey      String                @db.VarChar(512)
  mediaType     String                @db.VarChar(191)
  parsedText    String?               @db.LongText
  parseStatus   DocumentParseStatus   @default(NOT_REQUESTED)
  parseVersion  Int                   @default(0) @db.UnsignedInt
  parsedVersion Int?                  @db.UnsignedInt
  parsedAt      DateTime?             @db.DateTime(3)
  chunkedVersion Int?                @db.UnsignedInt
  chunks        DocumentChunk[]
  parseJobs     DocumentParseJob[]
  uploadedById  String?               @db.Char(36)
  uploadedBy    User?                 @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  fileSize      Int?                  @db.UnsignedInt
  sha256        String?               @db.Char(64)
  uploadKey     String?               @db.Char(36)
  storageStatus DocumentStorageStatus @default(LEGACY)
  errorCode     String?               @db.VarChar(100)
  uploadedAt    DateTime?             @db.DateTime(3)
  updatedAt     DateTime              @default(now()) @updatedAt @db.DateTime(3)
  createdAt     DateTime              @default(now()) @db.DateTime(3)
  project       Project               @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([projectId, uploadKey])
  @@index([projectId, createdAt])
}

enum DeliverableStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model Deliverable {
  id            String            @id @default(uuid()) @db.Char(36)
  projectId     String            @db.Char(36)
  taskId        String?           @db.Char(36)
  documentId    String            @unique @db.Char(36)
  name          String            @db.VarChar(191)
  seriesId      String            @db.Char(36)
  version       Int               @default(1) @db.UnsignedInt
  status        DeliverableStatus @default(DRAFT)
  createdById   String            @db.Char(36)
  submittedAt   DateTime?         @db.DateTime(3)
  submittedById String?           @db.Char(36)
  submittedBy   User?             @relation("DeliverableSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  reviewedById  String?           @db.Char(36)
  reviewedAt    DateTime?         @db.DateTime(3)
  reviewComment String?           @db.Text
  rowVersion    Int               @default(1) @db.UnsignedInt
  createdAt     DateTime          @default(now()) @db.DateTime(3)
  updatedAt     DateTime          @updatedAt @db.DateTime(3)
  project       Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  task          Task?             @relation(fields: [taskId], references: [id], onDelete: Restrict)
  document      Document          @relation(fields: [documentId], references: [id], onDelete: Restrict)
  createdBy     User              @relation("DeliverableCreator", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedBy    User?             @relation("DeliverableReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  @@unique([projectId, seriesId, version])
  @@index([projectId, taskId, status])
  @@index([projectId, createdAt])
}

model MeetingRecord {
  id          String   @id @default(uuid()) @db.Char(36)
  projectId   String   @db.Char(36)
  title       String   @db.VarChar(191)
  meetingDate DateTime @db.DateTime(3)
  content     String   @db.LongText
  actionItems Json
  createdById String   @db.Char(36)
  requestKey  String   @db.Char(36)
  visibleRoles Json    @default("[\"ADMIN\",\"PM\",\"QA\",\"MEMBER\"]")
  documentId  String?  @unique @db.Char(36)
  document    Document? @relation(fields: [documentId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now()) @db.DateTime(3)
  updatedAt   DateTime @updatedAt @db.DateTime(3)
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  @@unique([projectId, requestKey])
  @@index([projectId, meetingDate])
}

model AssetSourceJob {
  id         String @id @default(uuid()) @db.Char(36)
  documentId String @unique @db.Char(36)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  status     String @default("QUEUED") @db.VarChar(16)
  attempts   Int @default(0) @db.UnsignedInt
  nextRunAt  DateTime @default(now()) @db.DateTime(3)
  leaseToken String? @db.Char(36)
  leaseUntil DateTime? @db.DateTime(3)
  createdAt  DateTime @default(now()) @db.DateTime(3)
  updatedAt  DateTime @updatedAt @db.DateTime(3)
  @@index([status, nextRunAt, leaseUntil])
}

enum DocumentParseStatus {
  NOT_REQUESTED
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

model DocumentParseJob {
  id             String              @id @default(uuid()) @db.Char(36)
  documentId     String              @db.Char(36)
  version        Int                 @db.UnsignedInt
  requestedById  String              @db.Char(36)
  requestKey     String              @db.Char(36)
  status         DocumentParseStatus @default(QUEUED)
  phase          String              @default("RESERVE") @db.VarChar(32)
  provider       String              @default("mineru-cloud-v4") @db.VarChar(64)
  modelVersion   String              @db.VarChar(64)
  sourceSha256   String              @db.Char(64)
  sourceFilename String              @db.VarChar(512)
  sourceSize     Int                 @db.UnsignedInt
  remoteBatchId  String?             @db.VarChar(191)
  uploadUrl      String?             @db.Text
  attempts       Int                 @default(0) @db.UnsignedInt
  errorCode      String?             @db.VarChar(100)
  nextRunAt      DateTime            @default(now()) @db.DateTime(3)
  deadlineAt     DateTime            @db.DateTime(3)
  leaseToken     String?             @db.Char(36)
  leaseUntil     DateTime?           @db.DateTime(3)
  resultKey      String?             @db.VarChar(512)
  resultSha256   String?             @db.Char(64)
  markdown       String?             @db.LongText
  blocks         Json?
  ip             String?             @db.VarChar(45)
  userAgent      String?             @db.VarChar(512)
  createdAt      DateTime            @default(now()) @db.DateTime(3)
  updatedAt      DateTime            @default(now()) @updatedAt @db.DateTime(3)
  completedAt    DateTime?           @db.DateTime(3)
  document       Document            @relation(fields: [documentId], references: [id], onDelete: Restrict)
  requestedBy    User                @relation("DocumentParseRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  chunks         DocumentChunk[]

  @@unique([documentId, version])
  @@unique([documentId, requestKey])
  @@index([status, nextRunAt, leaseUntil])
  @@index([requestedById])
}

enum DocumentVectorStatus {
  PENDING
  SYNCED
  FAILED
}

model DocumentChunk {
  id             String               @id @default(uuid()) @db.Char(36)
  documentId     String               @db.Char(36)
  projectId      String               @db.Char(36)
  parseJobId     String               @db.Char(36)
  version        Int                  @db.UnsignedInt
  ordinal        Int                  @db.UnsignedInt
  text           String               @db.Text
  textSha256     String               @db.Char(64)
  page           Int?                 @db.UnsignedInt
  blockIndex     Int?                 @db.UnsignedInt
  startOffset    Int                  @db.UnsignedInt
  endOffset      Int                  @db.UnsignedInt
  embeddingModel String               @db.VarChar(191)
  vectorStatus   DocumentVectorStatus @default(PENDING)
  attempts       Int                  @default(0) @db.UnsignedInt
  nextRunAt      DateTime             @default(now()) @db.DateTime(3)
  leaseToken     String?              @db.Char(36)
  leaseUntil     DateTime?            @db.DateTime(3)
  errorCode      String?              @db.VarChar(100)
  createdAt      DateTime             @default(now()) @db.DateTime(3)
  document       Document             @relation(fields: [documentId], references: [id], onDelete: Restrict)
  parseJob       DocumentParseJob     @relation(fields: [parseJobId], references: [id], onDelete: Restrict)

  @@unique([documentId, version, ordinal])
  @@index([projectId, documentId, version])
  @@index([vectorStatus, nextRunAt, leaseUntil])
  @@index([parseJobId])
}

enum DocumentStorageStatus {
  LEGACY
  UPLOADING
  AVAILABLE
  FAILED
}

model SyncFailure {
  id         String   @id @default(uuid()) @db.Char(36)
  projectId  String?  @db.Char(36)
  entityType String   @db.VarChar(100)
  entityId   String   @db.Char(36)
  target     String   @db.VarChar(100)
  payload    Json
  error      String   @db.Text
  retryCount Int      @default(0) @db.UnsignedInt
  createdAt  DateTime @default(now()) @db.DateTime(3)
  updatedAt  DateTime @updatedAt @db.DateTime(3)
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([target, retryCount, createdAt])
  @@index([entityType, entityId])
  @@index([projectId, createdAt])
}
