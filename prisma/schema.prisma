model Document {
  testExecutions TestExecution[]
  id            String                @id @default(uuid()) @db.Char(36)
  projectId     String                @db.Char(36)
  filename      String                @db.VarChar(512)
  deliverable   Deliverable?
  meetingRecord MeetingRecord?
  meetingAttachmentId String? @db.Char(36)
  meetingAttachment MeetingRecord? @relation("MeetingAttachments", fields: [meetingAttachmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assetJob      AssetSourceJob?
  documentType  String                @default("DOCUMENT") @db.VarChar(32)
  visibleRoles  Json                  @default("[\"ADMIN\",\"PM\",\"QA\",\"MEMBER\"]")
  minioKey      String                @db.VarChar(512)
  mediaType     String                @db.VarChar(191)
  parsedText    String?               @db.LongText
  parseStatus   DocumentParseStatus   @default(NOT_REQUESTED)
  parseVersion  Int                   @default(0) @db.UnsignedInt
  parsedVersion Int?                  @db.UnsignedInt
  parsedAt      DateTime?             @db.DateTime(3)
  chunkedVersion Int?                @db.UnsignedInt
  chunks        DocumentChunk[]
  parseJobs     DocumentParseJob[]
  uploadedById  String?               @db.Char(36)
  uploadedBy    User?                 @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  fileSize      Int?                  @db.UnsignedInt
  sha256        String?               @db.Char(64)
  uploadKey     String?               @db.Char(36)
  storageStatus DocumentStorageStatus @default(LEGACY)
  errorCode     String?               @db.VarChar(100)
  uploadedAt    DateTime?             @db.DateTime(3)
  updatedAt     DateTime              @default(now()) @updatedAt @db.DateTime(3)
  createdAt     DateTime              @default(now()) @db.DateTime(3)
  project       Project               @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([projectId, uploadKey])
  @@index([meetingAttachmentId, createdAt])
  @@index([projectId, createdAt])
}

enum DeliverableStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model Deliverable {
  id            String            @id @default(uuid()) @db.Char(36)
  projectId     String            @db.Char(36)
  taskId        String?           @db.Char(36)
  documentId    String            @unique @db.Char(36)
  name          String            @db.VarChar(191)
  seriesId      String            @db.Char(36)
  version       Int               @default(1) @db.UnsignedInt
  status        DeliverableStatus @default(DRAFT)
  createdById   String            @db.Char(36)
  submittedAt   DateTime?         @db.DateTime(3)
  submittedById String?           @db.Char(36)
  submittedBy   User?             @relation("DeliverableSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  reviewedById  String?           @db.Char(36)
  reviewedAt    DateTime?         @db.DateTime(3)
  reviewComment String?           @db.Text
  rowVersion    Int               @default(1) @db.UnsignedInt
  createdAt     DateTime          @default(now()) @db.DateTime(3)
  updatedAt     DateTime          @updatedAt @db.DateTime(3)
  project       Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  task          Task?             @relation(fields: [taskId], references: [id], onDelete: Restrict)
  document      Document          @relation(fields: [documentId], references: [id], onDelete: Restrict)
  createdBy     User              @relation("DeliverableCreator", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedBy    User?             @relation("DeliverableReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  @@unique([projectId, seriesId, version])
  @@index([projectId, taskId, status])
  @@index([projectId, createdAt])
  @@index([createdAt])
}

model MeetingRecord {
  id          String   @id @default(uuid()) @db.Char(36)
  projectId   String   @db.Char(36)
