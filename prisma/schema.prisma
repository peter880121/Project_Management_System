generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PM
  MEMBER
  QA
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum RequirementStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  RETIRED
}

enum TestCaseStatus {
  NOT_RUN
  PASSED
  FAILED
  BLOCKED
}

enum AIRecommendationStatus {
  PENDING_CONFIRMATION
  ACCEPTED
  REJECTED
}

enum AiSuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum AiSuggestionType {
  WBS
  ESTIMATE
  RISK
  AUDIT_SUMMARY
}

model User {
  id                      String             @id @default(uuid()) @db.Char(36)
  email                   String             @unique @db.VarChar(191)
  name                    String             @db.VarChar(191)
  role                    Role               @default(MEMBER)
  createdAt               DateTime           @default(now()) @db.DateTime(3)
  updatedAt               DateTime           @updatedAt @db.DateTime(3)
  ownedProjects           Project[]          @relation("ProjectOwner")
  tasks                   Task[]
  reviewedRecommendations AIRecommendation[] @relation("RecommendationReviewer")
  reviewedSuggestions     AiSuggestion[]     @relation("SuggestionReviewer")
  auditLogs               AuditLog[]
}

model Project {
  id              String             @id @default(uuid()) @db.Char(36)
  name            String             @db.VarChar(191)
  description     String?            @db.Text
  status          ProjectStatus      @default(PLANNING)
  ownerId         String?            @db.Char(36)
  createdAt       DateTime           @default(now()) @db.DateTime(3)
  updatedAt       DateTime           @updatedAt @db.DateTime(3)
  owner           User?              @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  tasks           Task[]
  requirements    Requirement[]
  documents       Document[]
  recommendations AIRecommendation[]
  suggestions     AiSuggestion[]
  syncFailures    SyncFailure[]
  auditLogs       AuditLog[]

  @@index([ownerId, status])
}

model Task {
  id            String           @id @default(uuid()) @db.Char(36)
  projectId     String           @db.Char(36)
  assigneeId    String?          @db.Char(36)
  title         String           @db.VarChar(191)
  description   String?          @db.Text
  status        TaskStatus       @default(TODO)
  estimateHours Decimal?         @db.Decimal(8, 2)
  actualHours   Decimal?         @db.Decimal(8, 2)
  completedAt   DateTime?        @db.DateTime(3)
  dueDate       DateTime?        @db.DateTime(3)
  createdAt     DateTime         @default(now()) @db.DateTime(3)
  updatedAt     DateTime         @updatedAt @db.DateTime(3)
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  assignee      User?            @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  requirementId String?          @db.Char(36)
  requirement   Requirement?     @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  dependencies  TaskDependency[] @relation("TaskDependencies")
  blockedBy     TaskDependency[] @relation("TaskPrerequisites")

  @@index([projectId, status])
  @@index([assigneeId, status])
  @@index([dueDate, status])
  @@index([requirementId, status])
}

model TaskDependency {
  id              String   @id @default(uuid()) @db.Char(36)
  taskId          String   @db.Char(36)
  dependsOnTaskId String   @db.Char(36)
  createdAt       DateTime @default(now()) @db.DateTime(3)
  task            Task     @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn       Task     @relation("TaskPrerequisites", fields: [dependsOnTaskId], references: [id], onDelete: Restrict)

  @@unique([taskId, dependsOnTaskId])
  @@index([dependsOnTaskId])
}

model Requirement {
  id        String            @id @default(uuid()) @db.Char(36)
  projectId String            @db.Char(36)
  title     String            @db.VarChar(191)
  content   String            @db.Text
  version   Int               @default(1) @db.UnsignedInt
  status    RequirementStatus @default(DRAFT)
  createdAt DateTime          @default(now()) @db.DateTime(3)
  updatedAt DateTime          @updatedAt @db.DateTime(3)
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  tasks     Task[]
  testCases TestCase[]

  @@unique([projectId, title, version])
  @@index([projectId, status])
}

model TestCase {
  id            String         @id @default(uuid()) @db.Char(36)
  requirementId String         @db.Char(36)
  title         String         @db.VarChar(191)
  status        TestCaseStatus @default(NOT_RUN)
  createdAt     DateTime       @default(now()) @db.DateTime(3)
  updatedAt     DateTime       @updatedAt @db.DateTime(3)
  requirement   Requirement    @relation(fields: [requirementId], references: [id], onDelete: Restrict)

  @@index([requirementId, status])
}

// Retained for compatibility with records written by the first project scaffold.
model AIRecommendation {
  id           String                 @id @default(uuid()) @db.Char(36)
  projectId    String                 @db.Char(36)
  reviewedById String?                @db.Char(36)
  kind         String                 @db.VarChar(40)
  payload      Json
  status       AIRecommendationStatus @default(PENDING_CONFIRMATION)
  createdAt    DateTime               @default(now()) @db.DateTime(3)
  reviewedAt   DateTime?              @db.DateTime(3)
  project      Project                @relation(fields: [projectId], references: [id], onDelete: Restrict)
  reviewedBy   User?                  @relation("RecommendationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([projectId, status, createdAt])
}

model AiSuggestion {
  id           String             @id @default(uuid()) @db.Char(36)
  projectId    String             @db.Char(36)
  type         AiSuggestionType
  input        Json
  output       Json
  status       AiSuggestionStatus @default(PENDING)
  reviewedById String?            @db.Char(36)
  reviewedAt   DateTime?          @db.DateTime(3)
  createdAt    DateTime           @default(now()) @db.DateTime(3)
  project      Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  reviewedBy   User?              @relation("SuggestionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([projectId, status, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Char(36)
  actorId    String   @db.Char(36)
  projectId  String?  @db.Char(36)
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(100)
  entityId   String   @db.Char(36)
  before     Json?
  after      Json?
  ip         String?  @db.VarChar(45)
  userAgent  String?  @db.VarChar(512)
  createdAt  DateTime @default(now()) @db.DateTime(3)
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([projectId, createdAt])
  @@index([action, createdAt])
}

model Document {
  id         String   @id @default(uuid()) @db.Char(36)
  projectId  String   @db.Char(36)
  filename   String   @db.VarChar(512)
  minioKey   String   @db.VarChar(512)
  mediaType  String   @db.VarChar(191)
  parsedText String?  @db.LongText
  createdAt  DateTime @default(now()) @db.DateTime(3)
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
}

model SyncFailure {
  id         String   @id @default(uuid()) @db.Char(36)
  projectId  String?  @db.Char(36)
  entityType String   @db.VarChar(100)
  entityId   String   @db.Char(36)
  target     String   @db.VarChar(100)
  payload    Json
  error      String   @db.Text
  retryCount Int      @default(0) @db.UnsignedInt
  createdAt  DateTime @default(now()) @db.DateTime(3)
  updatedAt  DateTime @updatedAt @db.DateTime(3)
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([target, retryCount, createdAt])
  @@index([entityType, entityId])
  @@index([projectId, createdAt])
}
