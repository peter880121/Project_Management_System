  configuredBy   User     @relation(fields: [configuredById], references: [id], onDelete: Restrict)
  jobs           RiskScanJob[]
  @@index([enabled, nextRunAt])
}

enum RiskScanJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

model RiskScanJob {
  id              String            @id @default(uuid()) @db.Char(36)
